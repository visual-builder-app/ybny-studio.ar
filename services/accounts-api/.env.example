PORT=4000
# Preferred: read secrets from mounted files (written by runtime.py, never committed).
ACCOUNTS_DATABASE_URL_FILE=/run/ybny-api-secrets/database-url
ACCOUNTS_API_TOKEN_FILE=/run/ybny-api-secrets/service-token
# For a one-off local run outside Docker only; never commit a real value.
# ACCOUNTS_DATABASE_URL=postgresql://ybny_access_service:CHANGE_ME@127.0.0.1:5432/ybny_accounts
